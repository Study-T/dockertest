# 环境变量模板
# 使用方法：cp .env.example .env，然后修改 .env 中的实际值

# ========== 数据库配置 ==========
# PostgreSQL 连接字符串
DATABASE_URL=postgres://postgres:***@localhost:5432/your_database

# ========== Redis 配置 ==========
REDIS_HOST=localhost:6379
REDIS_PASSWORD=***

# ========== 日志配置 ==========
LOG_LEVEL=info
LOG_MODE=dev

# ========== 应用配置 ==========
APP_MODE=dev
HTTP_PORT=8082
